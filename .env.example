# Hosted Kerning. Copy to .env and fill in.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///kerning.db
# Production: postgresql://kerning:kerning@db:5432/kerning

APP_ORIGIN=http://127.0.0.1:8000
DEFAULT_TZ=Europe/Prague

# Vercel recut (kerning-six.vercel.app). Set in the Vercel project, not Fly.
# BLOB_READ_WRITE_TOKEN is added when you link a Blob store.
# TZ=Europe/Prague
# DIGEST_TZ=Europe/Prague

# Magic-link email. Without this, sign-in links print to the web process log
# and the landing page shows a local-dev link.
RESEND_API_KEY=
MAIL_FROM=Kerning <noreply@localhost>

# Optional Bluesky search buzz (author feeds work without this).
# BSKY_HANDLE=
# BSKY_APP_PASSWORD=

PEOPLE_CAP=80
RESOURCE_CAP=40
POOL_FRESH_HOURS=6
